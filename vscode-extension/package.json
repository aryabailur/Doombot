{
  "name": "doombot",
  "displayName": "Doombot",
  "description": "Agentic open-source maintainer assistant \u2014 companion view for the Doombot dashboard.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "doombot.searchIssues",
        "title": "Doombot: Search Issues"
      },
      {
        "command": "doombot.openDashboard",
        "title": "Doombot: Open Dashboard"
      },
      {
        "command": "doombot.openIssueGraph",
        "title": "Doombot: Open Issue Graph"
      },
      {
        "command": "doombot.triggerScan",
        "title": "Doombot: Trigger Repository Scan"
      },
      {
        "command": "doombot.scanRepository",
        "title": "Doombot: Analyse Repository"
      },
      {
        "command": "doombot.refreshEscalations",
        "title": "Doombot: Refresh Escalations"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "doombot",
          "title": "Doombot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "doombot": [
        {
          "id": "doombot.escalations",
          "name": "Escalations"
        },
        {
          "id": "doombot.investigations",
          "name": "Recent Investigations"
        }
      ]
    },
    "configuration": {
      "title": "Doombot",
      "properties": {
        "doombot.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL of the Doombot API."
        },
        "doombot.dashboardUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "URL of the running Doombot dashboard."
        },
        "doombot.repository": {
          "type": "string",
          "default": "",
          "description": "Repository to scan, as owner/repo."
        },
        "doombot.pollSeconds": {
          "type": "number",
          "default": 15,
          "description": "How often to refresh escalations and health."
        }
      }
    },
    "colors": [
      {
        "id": "doombot.critical",
        "description": "A critical escalation.",
        "defaults": {
          "dark": "#f2585d",
          "light": "#e5484d",
          "highContrast": "errorForeground"
        }
      },
      {
        "id": "doombot.high",
        "description": "A high-severity escalation.",
        "defaults": {
          "dark": "#ff8a5c",
          "light": "#ff6b35",
          "highContrast": "editorWarning.foreground"
        }
      },
      {
        "id": "doombot.warning",
        "description": "A warning-level escalation.",
        "defaults": {
          "dark": "#f0b93f",
          "light": "#e7a928",
          "highContrast": "editorWarning.foreground"
        }
      },
      {
        "id": "doombot.info",
        "description": "An informational escalation.",
        "defaults": {
          "dark": "#4d86ff",
          "light": "#246bfe",
          "highContrast": "editorInfo.foreground"
        }
      },
      {
        "id": "doombot.success",
        "description": "A completed investigation.",
        "defaults": {
          "dark": "#25c489",
          "light": "#19a974",
          "highContrast": "editorInfo.foreground"
        }
      },
      {
        "id": "doombot.accent",
        "description": "Doombot's brand accent.",
        "defaults": {
          "dark": "#ff5a36",
          "light": "#ff5a36",
          "highContrast": "editorInfo.foreground"
        }
      },
      {
        "id": "doombot.muted",
        "description": "An item with nothing to report.",
        "defaults": {
          "dark": "#8b8578",
          "light": "#737373",
          "highContrast": "descriptionForeground"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
