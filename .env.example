# Copy to .env and fill in. Never commit .env.

GITHUB_TOKEN=ghp_xxx
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b

DB_PATH=./doombot.db
CHROMA_DIR=./chroma_db

# 0 = call github_client directly (default, no subprocess risk)
# 1 = spawn a real MCP stdio session
USE_MCP_SUBPROCESS=0

# 1 = serve canned LLM responses; demo fallback if Groq rate-limits
DEMO_MODE=0

# Autonomous monitoring (F01, the compulsory PS-04 feature).
# Comma-separated owner/repo list. Empty = monitoring off, since the agent
# starts investigations on its own and would otherwise comment on repos the
# moment anyone runs uvicorn.
DOOMBOT_MONITOR_REPOS=
DOOMBOT_MONITOR_INTERVAL=120

# 1 = allow F16 to post a drafted resolution without maintainer approval.
# DEMO_MODE always overrides this.
DOOMBOT_AUTO_RESOLVE=0

# 1 = allow the triage graph to open a draft fix PR on its own when a past
# fix still applies (AUTO_FIX.md). Off by default: a pull request on someone
# else's repository is the most consequential write in the product.
# A human running "Doombot: Open Auto-Fix PR" from VS Code does not need this
# flag -- asking is its own authorization. DEMO_MODE always overrides both.
DOOMBOT_AUTO_FIX=0

# 1 = trust the locally cached sentence-transformer and skip HuggingFace's
# "is there a newer version" HTTP checks. Cuts model load from 11.4s to 6.8s,
# which is how long the API takes to become fast after a restart.
#
# Must be exported in the shell BEFORE uvicorn starts -- huggingface_hub reads
# it at import, which happens before .env is loaded. Leave it off on a machine
# that has never downloaded the model, or the first load will fail instead of
# fetching it.
#   HF_HUB_OFFLINE=1 GITHUB_TOKEN=$(gh auth token) python -m uvicorn api.main:app --port 8000
HF_HUB_OFFLINE=0

# --- Regression watching (the inverse of auto-fix) -------------------------
#
# 1 = let the monitoring poller replay every recent merged fix against the
# repository's current code, and act when one of them applies cleanly again --
# which can only mean the lines that fix added are gone. It files an issue
# describing the regression, and opens a draft PR restoring the fix when
# DOOMBOT_AUTO_FIX=1 is also set.
#
# Off by default, and DEMO_MODE=1 overrides it. This is the only part of the
# product that writes to GitHub with no human in the loop at all -- no issue
# was filed by a person and no button was clicked -- so it stays opt-in.
#
# Requires DOOMBOT_MONITOR_REPOS to name the repository: the watcher is a
# subtask of the monitoring cycle, not a poller of its own.
DOOMBOT_WATCH_REGRESSIONS=0
